  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "drizzle-kit": "0.24.0",
    "electron": "^31.0.0",
    "electron-builder": "24.13.3",
